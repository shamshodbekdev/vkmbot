# Telegram
TELEGRAM_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_USERNAME=@your_bot_username
TELEGRAM_ID=123456789
# Optional: point to a self-hosted Bot API server (raises the upload limit to 2 GB)
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_API_LOCAL=false

# Storage
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgres://user:password@localhost:5432/vkm_bot
