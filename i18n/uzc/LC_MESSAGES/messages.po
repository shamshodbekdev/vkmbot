#: src/handlers/admin/command/statistics.py:22
msgid ""
"<b>Bot statistics</b>\n"
"\n"
"Total audience: <b>%(total_word)s</b>\n"
"\n"
"<b>Users: %(private)s (+%(daily_new)s) (-%(kicked)s)</b>\n"
"%(uz)s UZ  |  %(en)s EN  |  %(ru)s RU\n"
"Premium: %(premium)s\n"
"Active: %(member)s\n"
"Kicked: %(kicked)s\n"
"\n"
"<b>Groups: %(groups)s (+%(daily_active)s) (-%(left)s)</b>\n"
"Active: %(active_groups)s\n"
"Left: %(left)s\n"
"\n"
"Updated at: <i>%(updated_at)s</i>"
msgstr ""
"<b>Бот статистикаси</b>\n"
"\n"
"Умумий аудитория: <b>%(total_word)s</b>\n"
"\n"
"<b>Фойдаланувчилар: %(private)s (+%(daily_new)s) (-%(kicked)s)</b>\n"
"%(uz)s UZ  |  %(en)s EN  |  %(ru)s RU\n"
"Premium: %(premium)s\n"
"Фаол: %(member)s\n"
"Чиқарилган: %(kicked)s\n"
"\n"
"<b>Гуруҳлар: %(groups)s (+%(daily_active)s) (-%(left)s)</b>\n"
"Фаол: %(active_groups)s\n"
"Чиқиб кетган: %(left)s\n"
"\n"
"Янгиланган вақт: <i>%(updated_at)s</i>"

#: src/keyboard/reply/manage.py:11
msgid "Statistics"
msgstr "Статистика"

#: src/handlers/admin/command/analytics.py:22
msgid ""
"<b>Analytics</b>\n"
"\n"
"<b>Daily: %(d_current)s  (%(d_change)s,  %(d_rate)s%%)</b>\n"
"UZ %(d_uz)s  |  EN %(d_en)s  |  RU %(d_ru)s\n"
"\n"
"<b>Weekly: %(w_current)s  (%(w_change)s,  %(w_rate)s%%)</b>\n"
"UZ %(w_uz)s  |  EN %(w_en)s  |  RU %(w_ru)s\n"
"\n"
"<b>Monthly: %(m_current)s  (%(m_change)s,  %(m_rate)s%%)</b>\n"
"UZ %(m_uz)s  |  EN %(m_en)s  |  RU %(m_ru)s\n"
"\n"
"<b>Health</b>\n"
"Database: %(database)s  |  Scheduler: %(queue)s  |  Cache: %(cache)s  |  Bot: %(bot)s\n"
"\n"
"Updated at: <i>%(updated_at)s</i>"
msgstr ""
"<b>Аналитика</b>\n"
"\n"
"<b>Кунлик: %(d_current)s  (%(d_change)s,  %(d_rate)s%%)</b>\n"
"UZ %(d_uz)s  |  EN %(d_en)s  |  RU %(d_ru)s\n"
"\n"
"<b>Ҳафталик: %(w_current)s  (%(w_change)s,  %(w_rate)s%%)</b>\n"
"UZ %(w_uz)s  |  EN %(w_en)s  |  RU %(w_ru)s\n"
"\n"
"<b>Ойлик: %(m_current)s  (%(m_change)s,  %(m_rate)s%%)</b>\n"
"UZ %(m_uz)s  |  EN %(m_en)s  |  RU %(m_ru)s\n"
"\n"
"<b>Ҳолат</b>\n"
"Маълумотлар базаси: %(database)s  |  Режалаштирувчи: %(queue)s  |  Кэш: %(cache)s  |  Бот: %(bot)s\n"
"\n"
"Янгиланган вақт: <i>%(updated_at)s</i>"

