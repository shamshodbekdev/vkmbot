#: src/handlers/admin/callback/subscription_manager.py
msgid "Use the Back button to cancel at any time."
msgstr "Используйте кнопку «Назад», чтобы отменить в любой момент."

#: src/handlers/admin/callback/subscription_manager.py
msgid ""
"<b>Step 1 — Channel or group</b>\n"
"\n"
"Send the channel or group <b>ID</b>, <b>@username</b>,\n"
"or <b>forward any message</b> from it.\n"
"\n"
"The bot must be an <b>administrator</b> in the channel or group."
msgstr ""
"<b>Шаг 1 — Канал или группа</b>\n"
"\n"
"Отправьте <b>ID</b> канала или группы, <b>@username</b>,\n"
"или <b>перешлите любое сообщение</b> оттуда.\n"
"\n"
"Бот должен быть <b>администратором</b> в канале или группе."

#: src/handlers/admin/command/subscription_manager.py
msgid "Channel or group not found. Please try again."
msgstr "Канал или группа не найдены. Пожалуйста, попробуйте снова."

#: src/handlers/admin/command/subscription_manager.py
msgid "Please send a chat ID, @username, or forward a message from the channel or group."
msgstr "Пожалуйста, отправьте chat ID, @username или перешлите сообщение из канала или группы."

#: src/handlers/admin/command/subscription_manager.py
msgid "Bot is not an administrator in <b>%(title)s</b>. Please add the bot as admin and try again."
msgstr "Бот не является администратором в <b>%(title)s</b>. Пожалуйста, добавьте бота как администратора и попробуйте снова."

#: src/handlers/admin/command/subscription_manager.py
msgid "Failed to verify bot permissions. Make sure the bot is an administrator."
msgstr "Не удалось проверить права бота. Убедитесь, что бот является администратором."

#: src/handlers/admin/command/subscription_manager.py
msgid ""
"<b>Step 2 — Invite link</b>\n"
"\n"
"Send an invite link for <b>%(title)s</b>,\n"
"or tap <b>Create here</b> to generate one automatically."
msgstr ""
"<b>Шаг 2 — Ссылка-приглашение</b>\n"
"\n"
"Отправьте ссылку-приглашение для <b>%(title)s</b>,\n"
"или нажмите <b>Create here</b>, чтобы сгенерировать её автоматически."

#: src/handlers/admin/command/subscription_manager.py
msgid "Failed to create invite link. Check bot permissions."
msgstr "Не удалось создать ссылку-приглашение. Проверьте права бота."

#: src/handlers/admin/command/subscription_manager.py
msgid "Please send a valid invite link starting with https://."
msgstr "Пожалуйста, отправьте корректную ссылку-приглашение, начинающуюся с https://."

#: src/handlers/admin/message/subscription_manager.py
msgid ""
"<b>Step 3 — Maximum audience</b>\n"
"\n"
"How many users can join via this link?\n"
"Send a number or tap <b>Use max: %(count)s</b> to use total registered users."
msgstr ""
"<b>Шаг 3 — Максимальная аудитория</b>\n"
"\n"
"Сколько пользователей могут присоединиться по этой ссылке?\n"
"Отправьте число или нажмите <b>Use max: %(count)s</b>, чтобы использовать общее количество зарегистрированных пользователей."

#: src/handlers/admin/command/subscription_manager.py
msgid "Please send a valid positive number."
msgstr "Пожалуйста, отправьте корректное положительное число."

#: src/handlers/admin/command/subscription_manager.py
msgid ""
"<b>%(title)s</b>\n"
"\n"
"Subscription added successfully."
msgstr ""
"<b>%(title)s</b>\n"
"\n"
"Подписка успешно добавлена."

#: src/handlers/admin/callback/subscription_manager.py
msgid "Subscription not found."
msgstr "Подписка не найдена."

