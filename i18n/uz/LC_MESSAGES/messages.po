msgstr "Istalgan vaqtda bekor qilish uchun Orqaga tugmasidan foydalaning."

#: src/handlers/admin/callback/subscription_manager.py
msgid ""
"<b>Step 1 — Channel or group</b>\n"
"\n"
"Send the channel or group <b>ID</b>, <b>@username</b>,\n"
"or <b>forward any message</b> from it.\n"
"\n"
"The bot must be an <b>administrator</b> in the channel or group."
msgstr ""
"<b>1-bosqich — Kanal yoki guruh</b>\n"
"\n"
"Kanal yoki guruhning <b>ID</b> sini, <b>@username</b> sini,\n"
"yoki undan <b>istalgan xabarni forward qiling</b>.\n"
"\n"
"Bot kanal yoki guruhda <b>administrator</b> bo'lishi kerak."

#: src/handlers/admin/command/subscription_manager.py
msgid "Channel or group not found. Please try again."
msgstr "Kanal yoki guruh topilmadi. Iltimos, qayta urinib ko'ring."

#: src/handlers/admin/command/subscription_manager.py
msgid "Please send a chat ID, @username, or forward a message from the channel or group."
msgstr "Iltimos, chat ID, @username yuboring yoki kanal/guruhdan xabarni forward qiling."

#: src/handlers/admin/command/subscription_manager.py
msgid "Bot is not an administrator in <b>%(title)s</b>. Please add the bot as admin and try again."
msgstr "Bot <b>%(title)s</b> da administrator emas. Iltimos, botni admin qilib qo'shing va qayta urinib ko'ring."

#: src/handlers/admin/command/subscription_manager.py
msgid "Failed to verify bot permissions. Make sure the bot is an administrator."
msgstr "Bot ruxsatlarini tekshirib bo'lmadi. Bot administrator ekanligiga ishonch hosil qiling."

#: src/handlers/admin/command/subscription_manager.py
msgid ""
"<b>Step 2 — Invite link</b>\n"
"\n"
"Send an invite link for <b>%(title)s</b>,\n"
"or tap <b>Create here</b> to generate one automatically."
msgstr ""
"<b>2-bosqich — Taklif havolasi</b>\n"
"\n"
"<b>%(title)s</b> uchun taklif havolasini yuboring,\n"
"yoki avtomatik yaratish uchun <b>Shu yerda yaratish</b> tugmasini bosing."

#: src/handlers/admin/command/subscription_manager.py
msgid "Failed to create invite link. Check bot permissions."
msgstr "Taklif havolasini yaratib bo'lmadi. Bot ruxsatlarini tekshiring."

#: src/handlers/admin/command/subscription_manager.py
msgid "Please send a valid invite link starting with https://."
msgstr "Iltimos, https:// bilan boshlanadigan yaroqli taklif havolasini yuboring."

#: src/handlers/admin/message/subscription_manager.py
msgid ""
"<b>Step 3 — Maximum audience</b>\n"
"\n"
"How many users can join via this link?\n"
"Send a number or tap <b>Use max: %(count)s</b> to use total registered users."
msgstr ""
"<b>3-bosqich — Maksimal auditoriya</b>\n"
"\n"
"Bu havola orqali nechta foydalanuvchi qo'shilishi mumkin?\n"
"Raqam yuboring yoki jami ro'yxatdan o'tgan foydalanuvchilar sonidan foydalanish uchun <b>Maksimaldan foydalanish: %(count)s</b> tugmasini bosing."

#: src/handlers/admin/command/subscription_manager.py
msgid "Please send a valid positive number."
msgstr "Iltimos, yaroqli musbat son yuboring."

#: src/handlers/admin/command/subscription_manager.py
msgid ""
"<b>%(title)s</b>\n"
"\n"
"Subscription added successfully."
msgstr ""
"<b>%(title)s</b>\n"
"\n"
"Obuna muvaffaqiyatli qo'shildi."

#: src/handlers/admin/callback/subscription_manager.py
